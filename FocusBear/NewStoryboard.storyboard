                                            <constraints>
                                                <constraint firstAttribute="width" constant="500" id="Kzz-bs-Ixd"/>
                                            </constraints>
                                            <textFieldCell key="cell" lineBreakMode="clipping" alignment="center" title="35/130 minutes complete" id="m8D-j1-zm6">
                                                <font key="font" metaFont="systemBold" size="14"/>
