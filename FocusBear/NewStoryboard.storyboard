                                            <rect key="frame" x="284" y="100" width="360" height="40"/>
                                            <buttonCell key="cell" type="square" title="xxStart Break" bezelStyle="shadowlessSquare" alignment="center" lineBreakMode="truncatingTail" state="on" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="PwC-9i-JqT">
