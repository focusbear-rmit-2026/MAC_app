                                            <rect key="frame" x="284" y="70" width="360" height="17"/>
                                            <buttonCell key="cell" type="square" title="xxSkip this habit for today" bezelStyle="shadowlessSquare" alignment="center" lineBreakMode="truncatingTail" state="on" imageScaling="proportionallyDown" inset="2" id="VQV-R7-rXD">
