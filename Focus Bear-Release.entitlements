<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release-only entitlements. Keep in sync with "Focus Bear.entitlements" (used by Debug/CI),
  which must NOT contain keychain-access-groups: that is a restricted entitlement and macOS
  SIGKILLs any process claiming it without a provisioning profile that grants it. Ad-hoc
  Debug/CI builds embed no profile, so they would refuse to launch.

  The group below is covered by FocusBearMainAppProfile (keychain-access-groups = TCUD568B3U.*),
  so no provisioning-profile changes are needed. It is what lets CredentialsKeychainStorage use
  the data-protection keychain instead of the legacy, ACL-guarded login keychain.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>TCUD568B3U.com.App.EarnYourScreentime</string>
	</array>
</dict>
</plist>
