# macOS Finder metadata — ignore in every folder.
.DS_Store

/FocusBear.xcworkspace/xcuserdata

# Sparkle is a large prebuilt binary framework — not committed to git.
# Fetch it with ./scripts/fetch-sparkle.sh (downloads the official signed release).
/Sparkle.framework/

# Local signing overrides for Debug (see Config/Local.xcconfig.example).
/Config/Local.xcconfig

# PyInstaller build artifacts for the embedded Flask server (docs/FlaskAppBuild).
docs/FlaskAppBuild/.venv_x86/
docs/FlaskAppBuild/build/
docs/FlaskAppBuild/dist/
docs/FlaskAppBuild/__pycache__/

# Vendored universal esptool binary for the Focus Button flasher — not committed.
# Fetch with ./scripts/fetch-esptool.sh
/esptool
build/

# Day Plan mockup renders (generated by scripts/mockups/render-mockup.sh)
/out/

# Swift Package Manager checkouts (resolved by Xcode, not source)
/SourcePackages/

# Never commit Sentry auth tokens. dSYM upload reads SENTRY_AUTH_TOKEN from the
# environment (see scripts/upload-dsyms.sh + docs/sentry-dsym-upload.md).
# The provision profiles in Certificates/ are intentionally tracked; this only
# excludes the leaked-token note that used to live here.
Certificates/Upload sentry files using sentry cli.rtfd/

# Vendored ONNX Runtime (fetched via scripts/fetch-onnxruntime.sh, not committed) — see
# FocusBear/RelevanceModel/README.md. Large prebuilt lib; pinned + checksum-verified.
FocusBear/RelevanceModel/onnxruntime/lib/
FocusBear/RelevanceModel/onnxruntime/include/
