{
  "_comment": [
    "Which UI tests a pull request runs (scripts/select-ui-tests.py; rules in docs/ui-tests.md).",
    "Paths are globs from the repository root: `*` stays inside one folder, `**` crosses folders.",
    "Tests are `Class` or `Class/testMethod`, as -only-testing takes them. Smoke always runs as well.",
    "A changed path that matches nothing here, or matches fullRun, runs the whole Regression plan.",
    "Every UI test class must be named here (the guard in scripts/select-ui-tests.py --check)."
  ],
  "fullRun": [
    "FocusBear/AppDelegate.swift",
    "FocusBear/AppDelegate+UITestSupport.swift",
    "FocusBear/globalFile.swift",
    "FocusBear/getViewControllersObject.swift",
    "FocusBear/showHideWindows.swift",
    "FocusBear/ViewController.swift",
    "FocusBear/mainWindowController.swift",
    "FocusBear/SettingsManager.swift",
    "FocusBear/AllApi.swift",
    "FocusBear/allExtension.swift",
    "FocusBear/allSubclasses.swift",
    "FocusBear/allUserdefaults.swift",
    "FocusBear/pusherEvents.swift",
    "FocusBear/UITestContract.swift",
    "FocusBear/Controls/**",
    "FocusBear/KeyboardNavigation.swift",
    "FocusBear/config.json",
    "FocusBear/config-*.json",
    "FocusBear/Info.plist",
    "*.entitlements",
    "FocusBear/Base.lproj/**",
    "FocusBear/Assets.xcassets/**",
    "FocusBear.xcodeproj/**",
    "FocusBear.xcworkspace/**",
    "Podfile",
    "Podfile.lock",
    "Config/**",
    "FocusBearUITests/UITestSupport.swift",
    "FocusBearUITests/SafeInteraction.swift",
    "FocusBearUITests/AccessibilityChecks.swift",
    "FocusBearUITests/*.xctestplan",
    "scripts/run-ui-tests.sh",
    "scripts/installed-focus-bear-cover.swift",
    "scripts/ui-test-runner-lease.sh",
    ".github/workflows/ui-tests.yml",
    ".github/ui-test-impact.json",
    "scripts/select-ui-tests.py"
  ],
  "noUITests": [
    "**/*.md",
    "docs/**",
    "plans/**",
    "FocusBearTests/**",
    "FBHelper/**",
    "DMG/**",
    "pkg/**",
    "update_builds/**",
    "Certificates/**",
    "FirefoxExtension/**",
    "scripts/test-*.py",
    "scripts/check-*.py",
    "scripts/config-assets-ignore.txt",
    "scripts/mockups/**",
    "scripts/local-runner/**",
    "scripts/*esptool*",
    "scripts/flash_focus_button.sh",
    "scripts/upload-dsyms.sh",
    "scripts/build-flask-server.sh",
    "scripts/make-uitest-app-icon.swift",
    ".github/workflows/unit-tests.yml",
    ".github/workflows/hardcoded-strings.yml",
    ".github/workflows/config-assets-sync.yml",
    ".github/workflows/qa-evidence-check.yml",
    ".github/workflows/claude.yml",
    ".github/workflows/devin-on-label.yml",
    ".github/workflows/ui-test-selection.yml",
    ".gitignore",
    "AGENTS.md"
  ],
  "areas": [
    {
      "name": "Day Plan",
      "paths": ["FocusBear/Schedule/**", "FocusBearUITests/RegressionDayPlanUITests.swift",
                "FocusBearUITests/DayPlanEditorsUITests.swift"],
      "tests": ["RegressionDayPlanUITests", "DayPlanEditorsUITests", "DayPlanAndToDoUITests",
                "AccessibilityVoiceOverUITests/testDayPlan", "AccessibilityVoiceOverUITests/testDayPlanEditors",
                "KeyboardAccessibilityUITests/testDayPlanIsKeyboardReachable",
                "KeyboardAccessibilityUITests/testDayPlanTaskNameTabGoesToDuration",
                "KeyboardAccessibilityUITests/testOpenAndCancelADayPlanEditorWithoutTheMouse",
                "KeyboardDefaultsUITests/testDayPlanTaskNameTabGoesToDuration"]
    },
    {
      "name": "To-do list and projects",
      "paths": ["FocusBear/ToDo/**", "FocusBear/Create task/**", "FocusBear/UITestContract+Tasks.swift",
                "FocusBearUITests/RegressionToDoUITests.swift", "FocusBearUITests/RegressionProjectsUITests.swift",
                "FocusBearUITests/ProjectsUITests.swift", "FocusBearUITests/DayPlanAndToDoUITests.swift"],
      "tests": ["RegressionToDoUITests", "RegressionProjectsUITests", "ProjectsUITests", "DayPlanAndToDoUITests",
                "RegressionShortcutsUITests/testCommandNOpensANewToDo",
                "RegressionShortcutsUITests/testCommandSSavesTheToDoBeingWritten",
                "RegressionShortcutsUITests/testEscapeAsksBeforeDiscardingAnEditedToDo",
                "AccessibilityVoiceOverUITests/testToDoScreens",
                "KeyboardAccessibilityUITests/testToDoListIsKeyboardReachable",
                "KeyboardAccessibilityUITests/testAddAToDoWithoutTheMouse",
                "KeyboardDefaultsUITests/testToDoEditorTitleTabMovesOn"]
    },
    {
      "name": "Settings",
      "paths": ["FocusBear/Preferences/**", "FocusBear/officeModeSettingsVc.swift", "FocusBear/shutOffTimeVc.swift",
                "FocusBear/enterPasswordVc.swift", "FocusBear/UITestContract+Settings.swift",
                "FocusBearUITests/SettingsUITests.swift", "FocusBearUITests/RegressionSettingsUITests.swift"],
      "tests": ["SettingsUITests", "RegressionSettingsUITests",
                "AccessibilityVoiceOverUITests/testSettingsAppearancePane",
                "AccessibilityVoiceOverUITests/testSettingsAccessibilityPane",
                "AccessibilityVoiceOverUITests/testSettingsAIPane",
                "AccessibilityVoiceOverUITests/testSettingsPomodoroPane",
                "AccessibilityVoiceOverUITests/testSettingsStrictnessPane",
                "AccessibilityVoiceOverUITests/testSettingsAccountPane",
                "AccessibilityVoiceOverUITests/testSettingsUninstallPane",
                "AccessibilityVoiceOverUITests/testSettingsMicroBreaksPane",
                "AccessibilityVoiceOverUITests/testSettingsPermissionsPane",
                "AccessibilityVoiceOverUITests/testSettingsToDoListPane",
                "AccessibilityVoiceOverUITests/testSettingsKeyboardShortcutsPane",
                "AccessibilityVoiceOverUITests/testSettingsOfficeModePane",
                "KeyboardAccessibilityUITests/testSettingsIsKeyboardReachable"]
    },
    {
      "name": "Focus sessions",
      "paths": ["FocusBear/Focus mode/**", "FocusBear/FocusSession/**", "FocusBear/FocusStart/**",
                "FocusBear/Pomodoro mode/**", "FocusBear/Abort/**", "FocusBear/smallCountDownVc.swift",
                "FocusBear/floatingTopBarVc.swift", "FocusBear/AccountabilityBuddy/**",
                "FocusBear/UITestContract+Sessions.swift",
                "FocusBearUITests/FocusSessionUITests.swift", "FocusBearUITests/RegressionFocusSessionUITests.swift"],
      "tests": ["FocusSessionUITests", "RegressionFocusSessionUITests",
                "AccessibilityVoiceOverUITests/testFocusSessionScreens",
                "KeyboardAccessibilityUITests/testFocusStartIsKeyboardReachable",
                "KeyboardAccessibilityUITests/testFocusStartDurationSliderStepsWithArrowKeys",
                "KeyboardAccessibilityUITests/testStartAndEndAFocusSessionWithoutTheMouse",
                "RegressionMenuBarUITests/testFocusStarterOpensWithoutStartingASession"]
    },
    {
      "name": "Breaks",
      "paths": ["FocusBear/Breaks/**", "FocusBear/popupAppointmentTimeVc.swift",
                "FocusBearUITests/RegressionBreaksUITests.swift"],
      "tests": ["RegressionBreaksUITests",
                "AccessibilityVoiceOverUITests/testMicroBreakScreens",
                "AccessibilityVoiceOverUITests/testMidMeetingBreakPopup",
                "KeyboardAccessibilityUITests/testMicroBreakScreensAreKeyboardReachable",
                "KeyboardAccessibilityUITests/testMidMeetingBreakPopupIsKeyboardReachable",
                "RegressionMenuBarUITests/testBreaksSectionOpens"]
    },
    {
      "name": "Routines and habits",
      "paths": ["FocusBear/Routine/**", "FocusBear/SkipHabit/**", "FocusBear/log Quantity/**",
                "FocusBear/activity Ongoing/**", "FocusBear/lateMorningHabitPopupVc.swift",
                "FocusBear/EveningShutdownScreen.swift", "FocusBear/takeActivityNotesVc.swift",
                "FocusBearUITests/RegressionRoutineUITests.swift"],
      "tests": ["RegressionRoutineUITests", "BlockingAndRoutineUITests",
                "ToolsUITests/testHabitEditorLoads",
                "AccessibilityVoiceOverUITests/testHabitsAndRoutine",
                "AccessibilityVoiceOverUITests/testNonTimerActivity",
                "KeyboardAccessibilityUITests/testNonTimerActivityIsKeyboardOperable"]
    },
    {
      "name": "Blocking",
      "paths": ["FocusBear/tabLimiter/**", "FocusBear/Firefox Permissions/**", "FocusBear/RelevanceModel/**",
                "FocusBear/Quit Process/**", "FocusBear/allBrowsers.swift",
                "FocusBear/AppBlockingHelper.swift", "FocusBear/AppleScriptScripting.swift",
                "FocusBear/intentionBlockedUrlsVc.swift", "FocusBear/setIntentionBlockedUrlsVc.swift",
                "FocusBear/savedSitesForLaterVc.swift", "FocusBear/urlValidation.swift",
                "FocusBear/firefoxHttpServer.swift", "FocusBear/flaskServer.swift", "FocusBear/server",
                "FocusBear/serverIntel", "FocusBear/InstalledApps.swift", "FocusBear/TabMatrics.swift",
                "FocusBear/UITestBlockingFixture.swift",
                "FocusBearUITests/BlockingAndRoutineUITests.swift", "FocusBearUITests/BlockingEnforcementUITests.swift",
                "FocusBearUITests/RegressionBlockingUITests.swift"],
      "tests": ["RegressionBlockingUITests", "BlockingEnforcementUITests", "BlockingAndRoutineUITests"]
    },
    {
      "name": "Managed and class sessions",
      "paths": ["FocusBear/ManagedBlocking/**", "FocusBear/UITestManagedSafetyFixture.swift",
                "FocusBear/UITestContract+Managed.swift", "FocusBearUITests/RegressionManagedSafetyUITests.swift"],
      "tests": ["RegressionManagedSafetyUITests"]
    },
    {
      "name": "Onboarding and sign-in",
      "paths": ["FocusBear/Onboarding/**", "FocusBear/Login/**", "FocusBear/Auth0/**", "FocusBear/splashVc.swift",
                "FocusBear/UITestContract+Onboarding.swift", "FocusBearUITests/AuthUITests.swift",
                "FocusBearUITests/AccountSignUpUITests.swift", "FocusBearUITests/RegressionOnboardingAuthUITests.swift"],
      "tests": ["RegressionOnboardingAuthUITests", "AuthUITests", "AccountSignUpUITests",
                "LaunchAndNavigationUITests/testLoggedOutLaunchOffersSignIn",
                "AccessibilityVoiceOverUITests/testOnboardingScreens",
                "AccessibilityVoiceOverUITests/testSignInForm",
                "AccessibilityVoiceOverUITests/testSignUpForm",
                "AccessibilityVoiceOverUITests/testOnboardingAndSignInControlsHaveDescriptiveNames",
                "KeyboardAccessibilityUITests/testOnboardingIsKeyboardReachable",
                "KeyboardAccessibilityUITests/testSignUpFormIsKeyboardReachable",
                "KeyboardAccessibilityUITests/testSignUpFormTabOrder",
                "KeyboardDefaultsUITests/testSignInFormTabGoesFromEmailToPassword",
                "KeyboardDefaultsUITests/testSignUpFormTabGoesFromEmailToPassword"]
    },
    {
      "name": "Main window and sidebar",
      "paths": ["FocusBear/leftMenu/**", "FocusBearUITests/LaunchAndNavigationUITests.swift"],
      "tests": ["LaunchAndNavigationUITests", "KeyboardAccessibilityUITests/testEscapeClosesSheetsAndMenus"]
    },
    {
      "name": "Menu bar",
      "paths": ["FocusBear/menuView/**", "FocusBear/PopoverViewController.swift", "FocusBear/micMonitor.swift",
                "FocusBearUITests/RegressionMenuBarUITests.swift"],
      "tests": ["RegressionMenuBarUITests", "ToolsUITests/testMenuBarPopoverOffersTheMainActions",
                "AccessibilityVoiceOverUITests/testMenuBarPopover",
                "KeyboardAccessibilityUITests/testEscapeClosesTheMenuBarPopover"]
    },
    {
      "name": "Tools (notes, stats, music, help, time tracker)",
      "paths": ["FocusBear/Notes/**", "FocusBear/Stats/**", "FocusBear/graph/**", "FocusBear/Sound/**",
                "FocusBear/Tracks/**", "FocusBear/FocusButton/**", "FocusBear/todoNotes.swift",
                "FocusBear/timeTrackerVc.swift", "FocusBear/FBTTTodayView.swift", "FocusBear/shareFeedbackVc.swift",
                "FocusBear/lateNoMorePopUpVc.swift", "FocusBear/LateNoMoreDismissSync.swift",
                "FocusBearUITests/ToolsUITests.swift", "FocusBearUITests/RegressionToolsUITests.swift"],
      "tests": ["ToolsUITests", "RegressionToolsUITests",
                "RegressionShortcutsUITests/testEscapeClosesTheNoteEditor",
                "RegressionMenuBarUITests/testFocusToolsOpenNotes",
                "RegressionMenuBarUITests/testFocusToolsOpenFocusMusic",
                "AccessibilityVoiceOverUITests/testToolScreens"]
    },
    {
      "name": "Keyboard shortcuts",
      "paths": ["FocusBear/HotKey/**", "FocusBear/HotkeyService.swift", "FocusBear/KeyActivation/**",
                "FocusBearUITests/RegressionShortcutsUITests.swift"],
      "tests": ["RegressionShortcutsUITests"]
    },
    {
      "name": "Accessibility suites (their own files)",
      "paths": ["FocusBearUITests/AccessibilityUITests.swift", "FocusBearUITests/KeyboardAccessibilityUITests.swift"],
      "tests": ["AccessibilityVoiceOverUITests", "KeyboardAccessibilityUITests", "KeyboardDefaultsUITests"]
    },
    {
      "name": "Events v2 (opt-in probe)",
      "paths": ["FocusBear/EventsService.swift", "FocusBearUITests/EventsV2UITests.swift"],
      "tests": ["EventsV2UITests"]
    },
    {
      "name": "Test-account cleanup",
      "paths": ["FocusBearUITests/A0AccountCleanupUITests.swift"],
      "tests": ["A0AccountCleanupUITests"]
    }
  ]
}
